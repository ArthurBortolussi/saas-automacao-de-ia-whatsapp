# ---------------------------------------------------------------
# Arthur AI — variáveis de ambiente (copie para .env na raiz).
# Valores abaixo são exemplos de DESENVOLVIMENTO.
# ---------------------------------------------------------------

NODE_ENV=development

# PostgreSQL (docker-compose.yml usa estas credenciais de dev)
DATABASE_URL=postgresql://arthur:arthur_dev_password@localhost:5432/arthur_ai
# Banco separado, usado exclusivamente pelos testes e2e (é truncado a cada suíte!)
TEST_DATABASE_URL=postgresql://arthur:arthur_dev_password@localhost:5432/arthur_ai_test

# API (NestJS)
API_PORT=4000
# Origem pública do frontend. Requisições mutáveis com Origin diferente recebem 403.
WEB_ORIGIN=http://localhost:3000
# Duração da sessão em horas.
SESSION_TTL_HOURS=168
# Cookie de sessão com flag Secure (nome vira __Host-aai_session). Lido pela API e pelo web.
# OBRIGATÓRIO "true" em produção (a API recusa subir sem isso). Em dev local (http), "false".
SESSION_COOKIE_SECURE=false
# "trust proxy" do Express: de quais proxies aceitar X-Forwarded-For.
# ATENÇÃO: o rewrite do Next.js NÃO adiciona o IP do cliente ao X-Forwarded-For; ele repassa
# o header que o cliente enviou. Portanto:
#   - sem proxy de borda (nginx/Caddy/LB) na frente do Next → use "false". O rate limit por IP
#     passa a agregar todos os clientes (vira limite global); o limite por e-mail continua valendo.
#   - com proxy de borda que reescreve/anexa X-Forwarded-For → use "1" (confia só no último hop).
# Nunca use "true" (a API recusa): qualquer cliente poderia forjar o próprio IP.
TRUST_PROXY=false

# Web (Next.js) — URL interna da API, usada pelo rewrite /api/* e pelos Server Components.
# Nunca é exposta ao navegador.
API_URL=http://localhost:4000

# ---------------------------------------------------------------
# WhatsApp Business Platform (Cloud API oficial da Meta) — Fase 3
# ---------------------------------------------------------------
# A integração liga quando as TRÊS variáveis abaixo estão preenchidas (ou nenhuma: aí fica
# desligada e o resto do sistema funciona normalmente). Configuração pela metade derruba o boot.
#
# ATENÇÃO: os valores abaixo são FICTÍCIOS, só para testar com a Graph API SIMULADA local.
# A API se recusa a subir em produção com eles. Para produção, gere valores novos (ver README).
#
# App Secret do app na Meta (Configurações do app > Básico). Valida X-Hub-Signature-256.
WHATSAPP_APP_SECRET=dev-app-secret-NAO-USAR-EM-PRODUCAO
# Texto livre que você define e informa à Meta ao cadastrar o webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token-NAO-USAR-EM-PRODUCAO
# Chave AES-256 (32 bytes em base64) que cifra os tokens das empresas no banco.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se trocar a chave, os tokens já salvos precisam ser cadastrados de novo.
WHATSAPP_TOKEN_ENCRYPTION_KEY=YXJ0aHVyLWFpLWNoYXZlLWZpY3RpY2lhLWRlLWRldiE=
# Versão da Graph API (oficialmente suportada). Padrão: v25.0.
WHATSAPP_GRAPH_API_VERSION=v25.0
# Endereço da Graph API. Oficial: https://graph.facebook.com
# Em desenvolvimento, aponta para o simulador local (pnpm whatsapp:mock-graph). Produção só aceita o oficial.
WHATSAPP_GRAPH_API_BASE_URL=http://localhost:4010
# Intervalo do processamento em segundo plano (fila de webhooks e retentativas), em ms. 0 desliga o timer.
WHATSAPP_WORKER_INTERVAL_MS=5000

# ---------------------------------------------------------------
# Inteligência artificial (API da Anthropic / Claude) — Fase 4
# ---------------------------------------------------------------
# Sem ANTHROPIC_API_KEY a IA fica "não configurada": nada responde automaticamente, e o resto do
# sistema (login, inbox, WhatsApp) funciona normalmente.
#
# ATENÇÃO: os valores abaixo são FICTÍCIOS e apontam para o SIMULADOR local (pnpm ai:mock-anthropic).
# Ele NÃO é o Claude: responde por regras simples. A API se recusa a subir em produção com eles.
# Para usar o Claude de verdade: coloque sua chave (console.anthropic.com) e APAGUE a linha
# ANTHROPIC_BASE_URL (o padrão é a API oficial). Nunca coloque a chave em commits, prints ou logs.
ANTHROPIC_API_KEY=sk-ant-dev-SIMULADO-NAO-E-UMA-CHAVE-REAL
ANTHROPIC_BASE_URL=http://localhost:4020
# Modelo dos atendimentos (padrão: claude-sonnet-5-5). Troque aqui, sem mexer no código.
AI_MODEL=claude-sonnet-5-5
# Esforço de raciocínio: low (padrão, mais rápido e barato para chat), medium ou high.
AI_EFFORT=low
# Teto de tokens por resposta (inclui o raciocínio interno do modelo).
AI_MAX_OUTPUT_TOKENS=3000
# Agrupamento: espera o cliente parar de escrever por AI_BATCH_DELAY_MS antes de responder;
# quem não para de escrever recebe resposta após AI_BATCH_MAX_WAIT_MS.
AI_BATCH_DELAY_MS=8000
AI_BATCH_MAX_WAIT_MS=30000
# Limites do contexto enviado ao modelo (custo): mensagens/caracteres do histórico e da base.
AI_HISTORY_MAX_MESSAGES=30
AI_HISTORY_MAX_CHARS=12000
AI_KNOWLEDGE_MAX_CHARS=40000
# Proteção contra loops (ex.: robô respondendo a IA): acima disso por hora, passa para humano.
AI_MAX_RUNS_PER_CONVERSATION_PER_HOUR=20
# Ciclo do processamento da IA em segundo plano, em ms. 0 desliga o timer.
AI_WORKER_INTERVAL_MS=2000
# Preço (US$ por milhão de tokens) do AI_MODEL, se não estiver na tabela interna ou se mudar.
# Informe os quatro ou nenhum. Tabela interna conferida em 2026-10-02 (ver README).
# AI_PRICE_INPUT_PER_MTOK=2
# AI_PRICE_OUTPUT_PER_MTOK=10
# AI_PRICE_CACHE_WRITE_PER_MTOK=2.5
# AI_PRICE_CACHE_READ_PER_MTOK=0.2

# ---------------------------------------------------------------
# Equipe e atendimento humano — Fase 5
# ---------------------------------------------------------------
# Ciclo do processamento da equipe em segundo plano (distribuir a fila, enviar avisos de espera,
# encerrar atendimentos inativos), em ms. 0 desliga o timer. O prazo de inatividade é por empresa
# (aba Equipe), não uma variável de ambiente.
TEAM_WORKER_INTERVAL_MS=5000
