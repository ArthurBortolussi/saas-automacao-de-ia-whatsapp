generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  SUPERADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  INACTIVE
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  name               String     @db.VarChar(120)
  // O índice único já atende às buscas por e-mail.
  email              String     @unique @db.VarChar(254)
  passwordHash       String
  globalRole         GlobalRole @default(USER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  sessions              Session[]
  membership            CompanyMember?
  auditEvents           AuditLog[]
  assignedConversations Conversation[]
  sentMessages          Message[]
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  // SHA-256 do token do cookie; o token em si nunca é persistido.
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // Sessão não tem valor sem o usuário.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String        @id @default(uuid(7)) @db.Uuid
  name          String        @db.VarChar(120)
  legalName     String?       @db.VarChar(200)
  slug          String        @unique @db.VarChar(140)
  industry      String        @db.VarChar(80)
  cnpj          String?       @db.VarChar(14)
  phone         String        @db.VarChar(13)
  email         String?       @db.VarChar(254)
  website       String?       @db.VarChar(255)
  address       String?       @db.VarChar(200)
  city          String?       @db.VarChar(80)
  state         String?       @db.Char(2)
  businessHours String?       @db.VarChar(200)
  status        CompanyStatus @default(ONBOARDING)
  // FASE 6: fuso dos relatórios (início/fim de cada dia). Não é o horário da IA (AiSettings.timezone).
  timezone      String        @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  members         CompanyMember[]
  auditEvents     AuditLog[]
  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  whatsappAccount WhatsAppAccount?
  webhookEvents   WhatsAppWebhookEvent[]
  aiSettings      AiSettings?
  knowledge       KnowledgeEntry[]
  aiReplyTasks    AiReplyTask[]
  assignments     ConversationAssignment[]
  teamSettings    TeamSettings?
  aiRuns          AiRun[]
  cycles          ConversationCycle[]

  @@index([status])
}

model CompanyMember {
  id                    String            @id @default(uuid(7)) @db.Uuid
  companyId             String            @db.Uuid
  // FASE 1: um usuário pertence a no máximo uma empresa. A autorização usa sempre o par
  // (userId, companyId); remover este @unique no futuro não exige mudar os guards.
  userId                String            @unique @db.Uuid
  role                  MemberRole
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  // ---- FASE 5: atendimento humano
  // Escolhida pelo próprio funcionário e persistida (não depende de navegador aberto). Nasce AWAY:
  // ninguém recebe conversas antes de se declarar disponível.
  availability          AgentAvailability @default(AWAY)
  availabilityChangedAt DateTime?         @db.Timestamptz(3)
  // Teto de atendimentos simultâneos (conversas ASSIGNED a ele), definido por OWNER/ADMIN.
  maxConcurrent         Int               @default(5)
  // Permissão para receber atendimentos (distribuição e transferências).
  canAttend             Boolean           @default(true)
  // Desempate da distribuição: quem recebeu há mais tempo recebe primeiro (rotação).
  lastAssignedAt        DateTime?         @db.Timestamptz(3)

  // Restrict: excluir empresa/usuário com vínculo deve ser uma decisão explícita, nunca cascata acidental.
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Conversas sob responsabilidade deste membro (FK composta garante a mesma empresa).
  assignedConversations Conversation[]

  // Também serve como índice para buscas por companyId (coluna líder).
  @@unique([companyId, userId])
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  // Opcional: login falho com e-mail inexistente não tem ator; o e-mail vai em metadata.
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @db.VarChar(64)
  entityId    String?  @db.VarChar(64)
  companyId   String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  // SetNull: o histórico de auditoria sobrevive à remoção do ator ou da empresa.
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- FASE 2

enum ContactStatus {
  NEW
  LEAD
  QUALIFIED
  CUSTOMER
  LOST
}

enum ContactSource {
  MANUAL
  WHATSAPP
  WEBSITE
  REFERRAL
  SOCIAL
  OTHER
}

/// AI: a IA (futura) pode responder. HUMAN: só humanos respondem. PAUSED: ninguém responde.
enum ConversationMode {
  AI
  HUMAN
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CONTACT
  AGENT
  AI
  SYSTEM
}

model Contact {
  id         String        @id @default(uuid(7)) @db.Uuid
  companyId  String        @db.Uuid
  name       String        @db.VarChar(120)
  // Somente dígitos, com DDI (ex.: 5511999990000).
  phone      String        @db.VarChar(15)
  // wa_id informado pela Meta (pode diferir do telefone digitado, ex.: 9º dígito no Brasil).
  whatsappId String?       @db.VarChar(20)
  email      String?       @db.VarChar(254)
  status     ContactStatus @default(NEW)
  source     ContactSource @default(MANUAL)
  notes      String?       @db.VarChar(2000)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  // Mesmo telefone pode existir em empresas diferentes, nunca duas vezes na mesma.
  // Também serve de índice para buscas por companyId.
  @@unique([companyId, phone])
  // Alvo das FKs compostas que impedem ligar registros de empresas diferentes.
  @@unique([id, companyId])
  @@unique([companyId, whatsappId])
  @@index([companyId, createdAt])
}

model Conversation {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  companyId          String                   @db.Uuid
  contactId          String                   @db.Uuid
  channel            ConversationChannel      @default(INTERNAL)
  mode               ConversationMode         @default(AI)
  // Modo a restaurar em "Reativar atendimento".
  modeBeforePause    ConversationMode?
  assignedUserId     String?                  @db.Uuid
  // Desnormalizados para a lista da inbox não precisar ler mensagens.
  lastMessageAt      DateTime?                @db.Timestamptz(3)
  lastMessagePreview String?                  @db.VarChar(160)
  unreadCount        Int                      @default(0)
  // Última mensagem do cliente: base da janela de atendimento de 24h do WhatsApp.
  lastInboundAt      DateTime?                @db.Timestamptz(3)
  // Fase 4: última passagem automática da IA para humano (motivo e quando).
  aiHandoffReason    AiHandoffReason?
  aiHandoffAt        DateTime?                @db.Timestamptz(3)
  // ---- FASE 5: estado operacional (independente do modo e da disponibilidade do funcionário)
  status             ConversationStatus       @default(OPEN)
  // Entrada na fila humana (ordem de chegada); só preenchido em QUEUED.
  queuedAt           DateTime?                @db.Timestamptz(3)
  // Aviso de espera ao cliente: enviado (uma vez por entrada na fila) ou motivo de não ter sido enviado.
  queueNoticeAt      DateTime?                @db.Timestamptz(3)
  queueNoticeError   String?                  @db.VarChar(40)
  assignedAt         DateTime?                @db.Timestamptz(3)
  // Início do ciclo de atendimento atual (criação ou reabertura).
  cycleStartedAt     DateTime?                @db.Timestamptz(3)
  // Última atividade relevante (mensagem recebida/enviada, atribuição): base do encerramento por inatividade.
  lastActivityAt     DateTime?                @db.Timestamptz(3)
  closedAt           DateTime?                @db.Timestamptz(3)
  closeReason        ConversationCloseReason?
  closedByUserId     String?                  @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // FK composta: o contato precisa ser da MESMA empresa da conversa (garantido pelo banco).
  contact        Contact                  @relation(fields: [contactId, companyId], references: [id, companyId], onDelete: Restrict)
  // SetNull: remover o usuário não apaga o atendimento, só o responsável.
  assignedUser   User?                    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  // FASE 5: o responsável precisa ser membro da MESMA empresa (garantido pelo banco).
  assignedMember CompanyMember?           @relation(fields: [companyId, assignedUserId], references: [companyId, userId], onDelete: Restrict, map: "Conversation_assignedMember_fkey")
  messages       Message[]
  aiReplyTasks   AiReplyTask[]
  aiRuns         AiRun[]
  assignments    ConversationAssignment[]
  cycles         ConversationCycle[]

  @@unique([id, companyId])
  @@index([companyId, lastMessageAt])
  // Fila por empresa em ordem de chegada; carga de cada funcionário; varredura de inatividade.
  @@index([companyId, status, queuedAt])
  @@index([companyId, assignedUserId, status])
  @@index([status, lastActivityAt])
  @@index([companyId, mode])
  @@index([contactId, channel])
}

model Message {
  id                String                 @id @default(uuid(7)) @db.Uuid
  companyId         String                 @db.Uuid
  conversationId    String                 @db.Uuid
  direction         MessageDirection
  senderType        MessageSenderType
  senderUserId      String?                @db.Uuid
  body              String                 @db.VarChar(4000)
  // ---- WhatsApp (nulos em mensagens internas)
  // wamid da Meta. Único por empresa: impede duplicar mensagens em reenvios de webhook.
  externalId        String?                @db.VarChar(128)
  // Tipo original na Meta (text, image, audio...). Só "text" tem conteúdo suportado nesta fase.
  externalType      String?                @db.VarChar(32)
  // Só para mensagens enviadas pelo WhatsApp. Avança de forma monotônica (ver código).
  deliveryStatus    MessageDeliveryStatus?
  sendAttempts      Int                    @default(0)
  nextSendAttemptAt DateTime?              @db.Timestamptz(3)
  sentAt            DateTime?              @db.Timestamptz(3)
  deliveredAt       DateTime?              @db.Timestamptz(3)
  readAt            DateTime?              @db.Timestamptz(3)
  failedAt          DateTime?              @db.Timestamptz(3)
  errorCode         String?                @db.VarChar(32)
  errorMessage      String?                @db.VarChar(500)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // FK composta: a mensagem pertence à MESMA empresa da conversa.
  conversation Conversation  @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  sender       User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  aiReplyTasks AiReplyTask[]

  @@unique([companyId, externalId])
  // Alvo da FK composta de AiReplyTask (Fase 4).
  @@unique([id, companyId])
  @@index([conversationId, createdAt])
  // Fase 6: contagens por período (empresa e plataforma).
  @@index([companyId, createdAt])
  @@index([deliveryStatus, nextSendAttemptAt])
}

// ---------------------------------------------------------------- FASE 3

enum ConversationChannel {
  INTERNAL
  WHATSAPP
}

/// PENDING → SENT → DELIVERED → READ; FAILED quando a Meta recusa ou não entrega.
enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// PENDING: configurado, ainda não testado. ACTIVE: teste ok. ERROR: a Meta recusou. DISABLED: desligado pelo SUPERADMIN.
enum WhatsAppAccountStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

/// Um número de WhatsApp Business por empresa nesta fase.
model WhatsAppAccount {
  id                    String                @id @default(uuid(7)) @db.Uuid
  companyId             String                @unique @db.Uuid
  wabaId                String                @db.VarChar(32)
  // Roteamento dos webhooks: único na plataforma inteira.
  phoneNumberId         String                @unique @db.VarChar(32)
  displayPhoneNumber    String                @db.VarChar(32)
  verifiedName          String?               @db.VarChar(120)
  status                WhatsAppAccountStatus @default(PENDING)
  // Token cifrado (AES-256-GCM, companyId como dado autenticado). Nunca sai da API.
  accessTokenCiphertext String                @db.Text
  tokenUpdatedAt        DateTime              @db.Timestamptz(3)
  lastCheckedAt         DateTime?             @db.Timestamptz(3)
  // Último erro, já sanitizado (sem tokens).
  lastErrorCode         String?               @db.VarChar(32)
  lastErrorMessage      String?               @db.VarChar(500)
  lastErrorAt           DateTime?             @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  // Restrict: desconectar é desativar; apagar empresa com número exige decisão explícita.
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

/// Fila persistente de webhooks: gravado na requisição, processado em segundo plano.
model WhatsAppWebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  // SHA-256 do corpo bruto: reenvios idênticos da Meta são descartados na entrada.
  payloadSha256 String             @unique @db.Char(64)
  payload       Json
  // Preenchido no processamento (um payload pode, em tese, ter vários números).
  companyId     String?            @db.Uuid
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @db.Timestamptz(3)
  lockedUntil   DateTime?          @db.Timestamptz(3)
  lastError     String?            @db.VarChar(500)
  receivedAt    DateTime           @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?          @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([companyId])
}

// ---------------------------------------------------------------- FASE 4

enum AiTone {
  FORMAL
  PROFESSIONAL
  FRIENDLY
}

/// Por que a IA passou a conversa para um humano.
enum AiHandoffReason {
  CUSTOMER_REQUEST
  MISSING_INFORMATION
  MODEL_REFUSAL
  INCOMPLETE_RESPONSE
  AI_ERROR
  UNSUPPORTED_CONTENT
  CONVERSATION_LIMIT
}

/// PENDING: aguardando o agrupamento. RUNNING: em geração. DONE: atendida (resposta ou passagem).
/// SKIPPED: não exigia/permitia resposta. CANCELED: invalidada (ex.: humano assumiu). FAILED: erro definitivo.
enum AiTaskStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  CANCELED
  FAILED
}

enum AiRunResult {
  REPLIED
  HANDOFF
  DISCARDED
  ERROR
}

/// Configuração da IA por empresa. Sem linha = valores padrão (IA desligada).
model AiSettings {
  companyId               String           @id @db.Uuid
  enabled                 Boolean          @default(false)
  // Modo em que nascem as NOVAS conversas do WhatsApp; conversas existentes não mudam.
  defaultConversationMode ConversationMode @default(AI)
  assistantName           String           @default("Assistente") @db.VarChar(60)
  tone                    AiTone           @default(PROFESSIONAL)
  instructions            String?          @db.VarChar(4000)
  handoffMessage          String?          @db.VarChar(1000)
  // Horário em que a IA pode responder (não é o horário de funcionamento da empresa).
  alwaysOn                Boolean          @default(true)
  timezone                String           @default("America/Sao_Paulo") @db.VarChar(64)
  // 0 = domingo ... 6 = sábado.
  scheduleDays            Int[]            @default([1, 2, 3, 4, 5])
  scheduleStart           String           @default("08:00") @db.Char(5)
  scheduleEnd             String           @default("18:00") @db.Char(5)
  // Pós-Fase 6: atendimento só com a IA (modo AI) sem atividade por este tempo é encerrado automaticamente.
  // Independente do prazo humano (TeamSettings.inactivityTimeoutMinutes).
  inactivityTimeoutMinutes Int             @default(240)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

/// Base de conhecimento: textos cadastrados pela empresa que a IA pode consultar.
model KnowledgeEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @db.Uuid
  title     String   @db.VarChar(160)
  content   String   @db.VarChar(10000)
  category  String?  @db.VarChar(60)
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, active, position])
}

/// Fila persistente da IA: uma tarefa por mensagem recebida (idempotência por messageId),
/// criada na MESMA transação que grava a mensagem. Tarefas da mesma conversa são agrupadas num lote (runId).
model AiReplyTask {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @db.Uuid
  conversationId String       @db.Uuid
  messageId      String       @unique @db.Uuid
  status         AiTaskStatus @default(PENDING)
  runId          String?      @db.Uuid
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  lockedUntil    DateTime?    @db.Timestamptz(3)
  // Motivo técnico do estado final (ex.: OUTSIDE_SCHEDULE, MODE_CHANGED). Sem dados de clientes.
  outcome        String?      @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?    @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  message      Message      @relation(fields: [messageId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([conversationId, status])
  @@index([runId])
}

/// Uma chamada ao modelo: consumo e resultado (base da aba Uso).
model AiRun {
  id                       String           @id @db.Uuid
  companyId                String           @db.Uuid
  conversationId           String           @db.Uuid
  model                    String           @db.VarChar(80)
  result                   AiRunResult
  stopReason               String?          @db.VarChar(40)
  handoffReason            AiHandoffReason?
  errorType                String?          @db.VarChar(60)
  // Nulos quando a API não devolveu consumo (ex.: erro antes da resposta).
  inputTokens              Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?
  // Estimativa em USD pela tabela de preços configurada; nulo = consumo ou preço desconhecido.
  costUsd                  Decimal?         @db.Decimal(12, 6)
  latencyMs                Int?
  // Quantas mensagens do cliente foram agrupadas nesta resposta.
  messageCount             Int
  // FASE 6: API chamada (oficial ou simulador), gravada no momento da execução. Nulo = registro anterior à
  // Fase 6: origem não verificada (nunca é deduzida depois).
  apiSource                AiApiSource?
  // FASE 6: ciclo de atendimento da conversa no momento da execução (custo por atendimento).
  cycleId                  String?          @db.Uuid
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation       @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  cycle        ConversationCycle? @relation(fields: [cycleId, companyId], references: [id, companyId], onDelete: Restrict, map: "AiRun_cycle_fkey")

  @@index([companyId, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@index([cycleId])
}

// ---------------------------------------------------------------- FASE 5

/// Disponibilidade escolhida pelo funcionário. Só AVAILABLE recebe conversas novas; BUSY/AWAY mantêm as atuais.
enum AgentAvailability {
  AVAILABLE
  BUSY
  AWAY
}

/// Estado operacional da conversa (não confundir com o modo AI/HUMAN/PAUSED).
/// OPEN: em andamento sem atendimento humano alocado (IA, ou humana antiga sem responsável).
/// QUEUED: aguardando um funcionário. ASSIGNED: com um funcionário. CLOSED: atendimento finalizado.
enum ConversationStatus {
  OPEN
  QUEUED
  ASSIGNED
  CLOSED
}

enum ConversationCloseReason {
  MANUAL
  INACTIVITY
}

/// Como um período de responsabilidade começou.
enum AssignmentStartReason {
  AUTO
  TRANSFER
  ASSUME
  CREATED
}

/// Como um período de responsabilidade terminou.
enum AssignmentEndReason {
  TRANSFERRED
  CLOSED
  RETURNED_TO_AI
  REQUEUED
}

/// Histórico de responsáveis: um registro por período em que um funcionário cuidou da conversa.
/// A fonte da verdade do responsável atual é Conversation.assignedUserId; isto é o histórico.
model ConversationAssignment {
  id             String                @id @default(uuid(7)) @db.Uuid
  companyId      String                @db.Uuid
  conversationId String                @db.Uuid
  userId         String                @db.Uuid
  startReason    AssignmentStartReason
  // Quem fez a ação (nulo = sistema/distribuição automática).
  actorUserId    String?               @db.Uuid
  assignedAt     DateTime              @default(now()) @db.Timestamptz(3)
  endedAt        DateTime?             @db.Timestamptz(3)
  endReason      AssignmentEndReason?

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([conversationId, assignedAt])
  @@index([companyId, userId, assignedAt])
}

/// Configurações do atendimento humano por empresa. Sem linha = padrões.
model TeamSettings {
  companyId                String   @id @db.Uuid
  // Atendimento atribuído sem atividade por este tempo é finalizado automaticamente.
  inactivityTimeoutMinutes Int      @default(240)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------- FASE 6

/// Para onde a execução da IA foi enviada. OFFICIAL: api.anthropic.com. SIMULATED: qualquer outro endereço (simulador).
enum AiApiSource {
  OFFICIAL
  SIMULATED
}

/// Como o ciclo de atendimento começou. BACKFILL: reconstruído na migração da Fase 6 a partir dos dados existentes
/// (só fatos verificáveis; tempos de resposta e de fila desses ciclos não são calculados).
enum CycleOrigin {
  NEW_CONVERSATION
  REOPENED
  BACKFILL
}

/// Um ciclo de atendimento (base do Analytics): da criação ou reabertura da conversa até o encerramento.
/// A mesma conversa pode ter vários ciclos; no máximo um aberto (índice parcial escrito à mão na migração).
/// Os marcos são gravados nas MESMAS transações dos fluxos das Fases 3 a 5 e só avançam (COALESCE/soma).
model ConversationCycle {
  id                String                   @id @default(uuid(7)) @db.Uuid
  companyId         String                   @db.Uuid
  conversationId    String                   @db.Uuid
  origin            CycleOrigin
  // Modo no início do ciclo; nulo nos ciclos reconstruídos (o modo inicial não foi registrado).
  startMode         ConversationMode?
  startedAt         DateTime                 @db.Timestamptz(3)
  // Primeira ação da IA no ciclo (resposta enviada ou transferência para humano).
  aiFirstAt         DateTime?                @db.Timestamptz(3)
  // Transferências feitas pela IA para atendimento humano neste ciclo.
  aiHandoffCount    Int                      @default(0)
  // Primeiro pedido de atendimento humano: entrada na fila ou atribuição direta (o que vier antes).
  humanRequestedAt  DateTime?                @db.Timestamptz(3)
  firstQueuedAt     DateTime?                @db.Timestamptz(3)
  // Espera em andamento (entrada na fila ainda sem atribuição).
  queueEnteredAt    DateTime?                @db.Timestamptz(3)
  // Soma das esperas concluídas por atribuição e quantas foram.
  queueWaitMs       BigInt                   @default(0)
  queueWaitCount    Int                      @default(0)
  firstAssignedAt   DateTime?                @db.Timestamptz(3)
  // Primeira mensagem de um funcionário no ciclo (IA, avisos e mensagens do sistema não contam).
  firstHumanReplyAt DateTime?                @db.Timestamptz(3)
  closedAt          DateTime?                @db.Timestamptz(3)
  closeReason       ConversationCloseReason?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  aiRuns       AiRun[]

  @@unique([id, companyId])
  @@index([companyId, startedAt])
  @@index([companyId, closedAt])
  @@index([conversationId, startedAt])
  @@index([startedAt])
  @@index([closedAt])
}
